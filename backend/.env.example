APP_NAME="Sistema Escolar"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_TIMEZONE=America/Lima
APP_LOCALE=es
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=es_PE

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
# En producción (con https): SESSION_SECURE_COOKIE=true y SESSION_ENCRYPT=true.
# Junto con APP_ENV=production y APP_DEBUG=false. Compruébalo con:
#   php artisan colegio:revisar-seguridad
SESSION_SECURE_COOKIE=
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Contraseña con la que nacen las cuentas de alumnos, personal y apoderados.
# El sistema obliga a cambiarla en el primer ingreso.
COLEGIO_CLAVE_INICIAL=123456

# Push de la app: ruta al JSON de la cuenta de servicio de Firebase, fuera de
# public/. Vacío = sin push (los mensajes igual quedan en la bandeja de la app).
FCM_CREDENCIALES=

# Base de datos del sistema anterior. Solo se usa (y solo para leer) al
# ejecutar `php artisan colegio:importar-anterior`.
ANTERIOR_DB_HOST=127.0.0.1
ANTERIOR_DB_PORT=3306
ANTERIOR_DB_DATABASE=
ANTERIOR_DB_USERNAME=
ANTERIOR_DB_PASSWORD=
# Carpeta "uploads" del sistema anterior (para traer las fotos del carné)
ANTERIOR_RUTA_FOTOS=
